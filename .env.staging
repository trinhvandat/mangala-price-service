# =============================================================================
# mangala-price-service - Staging Environment
# =============================================================================
# Copy to .env on your VPS before running docker-compose
# =============================================================================

# Redis (internal Docker network)
REDIS_URL=redis://redis:6379

# Kafka (internal Docker network)
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# CoinGecko Price Feed
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TOKENS=bitcoin,ethereum,binancecoin,matic-network,solana,usd-coin,tether,avalanche-2,arbitrum,optimism

# Price Scheduler (60 seconds for staging)
PRICE_SCHEDULER_ENABLED=true
PRICE_SCHEDULER_INTERVAL=60000
PRICE_SCHEDULER_INITIAL_DELAY=10000
