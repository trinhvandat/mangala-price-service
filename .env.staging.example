# =============================================================================
# mangala-price-service - Staging Environment Variables
# =============================================================================
# Copy this file to .env.staging (or .env) and fill in your values
# For CI/CD, these should be set as GitHub Secrets instead
# =============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=staging

# Redis Configuration
REDIS_URL=redis://redis:6379

# Kafka Configuration
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# CoinGecko API Configuration
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TOKENS=bitcoin,ethereum,binancecoin,matic-network,solana,usd-coin,tether,avalanche-2,arbitrum,optimism

# Price Scheduler Configuration
PRICE_SCHEDULER_ENABLED=true
PRICE_SCHEDULER_INTERVAL=60000
PRICE_SCHEDULER_INITIAL_DELAY=10000

# JVM Options (optional, defaults are set in docker-compose)
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Xms256m -Xmx512m
