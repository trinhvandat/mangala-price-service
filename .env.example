# =============================================================================
# mangala-price-service - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Platform / Docker Networking
# Use host.docker.internal when running inside Docker on macOS/Windows.
# -----------------------------------------------------------------------------
PLATFORM_HOST=host.docker.internal

# -----------------------------------------------------------------------------
# Redis (Price Cache)
# -----------------------------------------------------------------------------
REDIS_URL=redis://mangala-redis:6379

# -----------------------------------------------------------------------------
# Kafka (Price Event Publishing)
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=mangala-kafka:9092
KAFKA_ENABLED=true

# -----------------------------------------------------------------------------
# CoinGecko Price Feed
# -----------------------------------------------------------------------------
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Comma-separated CoinGecko token IDs to track
COINGECKO_TOKENS=bitcoin,ethereum,binancecoin,matic-network,solana,usd-coin,tether,avalanche-2,arbitrum,optimism

# -----------------------------------------------------------------------------
# Price Scheduler
# Controls how often prices are fetched from CoinGecko.
# -----------------------------------------------------------------------------
PRICE_SCHEDULER_ENABLED=true
# Fetch interval in milliseconds (default: 30 seconds)
PRICE_SCHEDULER_INTERVAL=30000
# Initial delay before the first fetch in milliseconds (default: 5 seconds)
PRICE_SCHEDULER_INITIAL_DELAY=5000
